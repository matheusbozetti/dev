[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = delta
    filemode = false
    autocrlf = false
    eol = lf
    excludesfile = ~/.gitignore_global

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[pull]
    rebase = false

[fetch]
    prune = true
    pruneTags = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[rerere]
    enabled = true
    autoupdate = true

[status]
    short = true
    branch = true
    showStash = true

[color]
    ui = auto

[color "branch"]
    current = yellow bold
    local = green bold
    remote = cyan bold

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse

[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold

[alias]
    s = status -sb
    a = add --all
    c = commit -m
    ca = commit --amend --no-edit
    cm = commit
    co = checkout
    sw = switch
    br = branch
    last = log -1 HEAD --stat
    l = log --graph --pretty=format:'%C(blue)%h%C(red)%d %C(white)%s - %C(cyan)%cn | %C(green)%cr' --abbrev-commit
    ll = log --graph --oneline --decorate --all
    undo = reset --soft HEAD~1
    unstage = restore --staged
    discard = restore
    cleanup = "!git branch --merged | grep -vE '^[* ] (main|master|develop|staging|production)$' | xargs -r git branch -d"
    gone = "!git fetch --prune && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"

[safe]
    directory = *
